          ql_shape_id = take_anyif(ql_shape_key, isnotempty(ql_shape_key)),
          ql_sample_query_text = take_anyif(ql_raw_text, isnotempty(ql_raw_text)),
          ql_returned_rows = sum(ql_returned_count)
        by ql_activity_id = coalesce(tostring(column_ifexists("activityId_g", "")), tostring(column_ifexists("ActivityId_g", "")), "");
  let ql_joined = materialize(
      ql_qrs
      | join kind=inner ql_reqs on ql_activity_id
  );
  let ql_known_db_by_shape_container = ql_joined
  | where isnotempty(ql_db_name) and ql_db_name != "(unknown)"
      and isnotempty(ql_coll_name) and ql_coll_name != "(unknown)"
  | summarize by ql_shape_id, ql_coll_name, ql_known_db = ql_db_name;
  let ql_single_db_shape_containers = ql_known_db_by_shape_container
  | summarize
      ql_db_count = count(),
      ql_resolved_db = take_any(ql_known_db)
    by ql_shape_id, ql_coll_name
  | where ql_db_count == 1;
  let ql_resolved_activities = ql_joined
  | join kind=leftouter ql_single_db_shape_containers on ql_shape_id, ql_coll_name
  | extend
      ql_db_name = iff(
          isnotempty(ql_db_name) and ql_db_name != "(unknown)",
          ql_db_name,
          coalesce(ql_resolved_db, "(unknown)")
      ),
      ql_coll_name = iff(
          isnotempty(ql_coll_name) and ql_coll_name != "(unknown)",
          ql_coll_name,
          "(unknown)"
      );
  let ql_top_shapes = materialize(
      ql_resolved_activities
      | summarize
