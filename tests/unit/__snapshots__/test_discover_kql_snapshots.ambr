          ),
          3
      )
    by ql_db_name, ql_coll_name, ql_shape_id;
  ql_top_shapes
  | join kind=leftouter ql_top_callers_per_shape on ql_db_name, ql_coll_name, ql_shape_id
  | project
      ql_db_name, ql_coll_name, ql_shape_id, ql_sample_text,
      ql_execution_count, ql_total_ru, ql_max_ru, ql_total_returned_rows,
      ql_throttled_count,
      ql_top_callers = coalesce(ql_top_callers, dynamic([]))
  
  // === Query 2: Window & Attributed Totals Query ===
  let ql_reqs = materialize(
      AzureDiagnostics
      | where Category == "DataPlaneRequests" and ResourceProvider =~ "MICROSOFT.DOCUMENTDB"
      | where _ResourceId endswith "/databaseaccounts/cosmos-prod-eastus"
      | summarize
          ql_total_charge = sum(todouble(coalesce(tostring(column_ifexists("requestCharge_s", "")), tostring(column_ifexists("RequestCharge_s", "")), "0"))),
          ql_earliest_time = min(TimeGenerated)
        by ql_activity_id = coalesce(tostring(column_ifexists("activityId_g", "")), tostring(column_ifexists("ActivityId_g", "")), "")
  );
  let ql_qrs = AzureDiagnostics
      | where Category == "QueryRuntimeStatistics" and ResourceProvider =~ "MICROSOFT.DOCUMENTDB"
      | where _ResourceId endswith "/databaseaccounts/cosmos-prod-eastus"
      | summarize by ql_activity_id = coalesce(tostring(column_ifexists("activityId_g", "")), tostring(column_ifexists("ActivityId_g", "")), "");
  let ql_window_total = toscalar(ql_reqs | summarize sum(ql_total_charge));
  let ql_min_time = toscalar(ql_reqs | summarize min(ql_earliest_time));
  ql_qrs
  | join kind=inner ql_reqs on ql_activity_id
  | summarize
      ql_attributed_total_ru = sum(ql_total_charge),
      ql_total_executions = count()
  | extend
      ql_window_total_ru = ql_window_total,
      ql_min_time_generated = ql_min_time
  
  '''
# ---
