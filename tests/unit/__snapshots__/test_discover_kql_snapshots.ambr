# serializer version: 1
# name: test_discover_kql_check_snapshots
  '''
  // === Preflight Diagnostic Check Query ===
  let ql_base = AzureDiagnostics
      | where ResourceProvider =~ "MICROSOFT.DOCUMENTDB";
  let ql_counts = ql_base
  | summarize
      ql_dataplane_count = countif(Category == "DataPlaneRequests"),
      ql_queryruntime_count = countif(Category == "QueryRuntimeStatistics"),
      ql_earliest_time = min(TimeGenerated),
      ql_latest_time = max(TimeGenerated),
      ql_has_shapesignature = countif(
          Category == "QueryRuntimeStatistics" and isnotempty(coalesce(tostring(column_ifexists("shapesignature_s", "")), tostring(column_ifexists("ShapeSignature_s", "")), tostring(column_ifexists("shapeSignature_s", "")), ""))
      ),
      ql_has_querytext = countif(
          Category == "QueryRuntimeStatistics" and isnotempty(coalesce(tostring(column_ifexists("querytext_s", "")), tostring(column_ifexists("QueryText_s", "")), tostring(column_ifexists("queryText_s", "")), ""))
      ),
      ql_has_aad_guid = countif(
          Category == "DataPlaneRequests" and isnotempty(coalesce(tostring(column_ifexists("aadPrincipalId_g", "")), tostring(column_ifexists("AadPrincipalId_g", "")), ""))
      ),
      ql_has_aad_str = countif(
          Category == "DataPlaneRequests" and isnotempty(coalesce(tostring(column_ifexists("aadPrincipalId_s", "")), tostring(column_ifexists("AadPrincipalId_s", "")), ""))
      ),
      ql_has_client_ip = countif(
          Category == "DataPlaneRequests" and isnotempty(coalesce(tostring(column_ifexists("clientIpAddress_s", "")), tostring(column_ifexists("ClientIpAddress_s", "")), ""))
      ),
      ql_has_useragent = countif(
          Category == "DataPlaneRequests" and isnotempty(coalesce(tostring(column_ifexists("userAgent_s", "")), tostring(column_ifexists("useragent_s", "")), tostring(column_ifexists("UserAgent_s", "")), ""))
      );
  let ql_auth = toscalar(
      ql_base
      | where Category == "DataPlaneRequests" and isnotempty(coalesce(tostring(column_ifexists("authTokenType_s", "")), tostring(column_ifexists("authtokentype_s", "")), tostring(column_ifexists("AuthTokenType_s", "")), ""))
      | summarize ql_count = count() by ql_auth_type = coalesce(tostring(column_ifexists("authTokenType_s", "")), tostring(column_ifexists("authtokentype_s", "")), tostring(column_ifexists("AuthTokenType_s", "")), "")
      | summarize make_bag(bag_pack(ql_auth_type, ql_count))
  );
  ql_counts
  | extend ql_auth_breakdown = ql_auth
  
  '''
# ---
# name: test_discover_kql_check_with_account_snapshots
  '''
  // === Preflight Diagnostic Check Query ===
  let ql_base = AzureDiagnostics
      | where ResourceProvider =~ "MICROSOFT.DOCUMENTDB"
      | where _ResourceId endswith "/databaseaccounts/cosmos-prod-eastus";
  let ql_counts = ql_base
  | summarize
      ql_dataplane_count = countif(Category == "DataPlaneRequests"),
      ql_queryruntime_count = countif(Category == "QueryRuntimeStatistics"),
      ql_earliest_time = min(TimeGenerated),
      ql_latest_time = max(TimeGenerated),
      ql_has_shapesignature = countif(
          Category == "QueryRuntimeStatistics" and isnotempty(coalesce(tostring(column_ifexists("shapesignature_s", "")), tostring(column_ifexists("ShapeSignature_s", "")), tostring(column_ifexists("shapeSignature_s", "")), ""))
      ),
      ql_has_querytext = countif(
          Category == "QueryRuntimeStatistics" and isnotempty(coalesce(tostring(column_ifexists("querytext_s", "")), tostring(column_ifexists("QueryText_s", "")), tostring(column_ifexists("queryText_s", "")), ""))
      ),
      ql_has_aad_guid = countif(
          Category == "DataPlaneRequests" and isnotempty(coalesce(tostring(column_ifexists("aadPrincipalId_g", "")), tostring(column_ifexists("AadPrincipalId_g", "")), ""))
      ),
      ql_has_aad_str = countif(
          Category == "DataPlaneRequests" and isnotempty(coalesce(tostring(column_ifexists("aadPrincipalId_s", "")), tostring(column_ifexists("AadPrincipalId_s", "")), ""))
      ),
      ql_has_client_ip = countif(
          Category == "DataPlaneRequests" and isnotempty(coalesce(tostring(column_ifexists("clientIpAddress_s", "")), tostring(column_ifexists("ClientIpAddress_s", "")), ""))
      ),
      ql_has_useragent = countif(
          Category == "DataPlaneRequests" and isnotempty(coalesce(tostring(column_ifexists("userAgent_s", "")), tostring(column_ifexists("useragent_s", "")), tostring(column_ifexists("UserAgent_s", "")), ""))
      );
  let ql_auth = toscalar(
      ql_base
      | where Category == "DataPlaneRequests" and isnotempty(coalesce(tostring(column_ifexists("authTokenType_s", "")), tostring(column_ifexists("authtokentype_s", "")), tostring(column_ifexists("AuthTokenType_s", "")), ""))
      | summarize ql_count = count() by ql_auth_type = coalesce(tostring(column_ifexists("authTokenType_s", "")), tostring(column_ifexists("authtokentype_s", "")), tostring(column_ifexists("AuthTokenType_s", "")), "")
      | summarize make_bag(bag_pack(ql_auth_type, ql_count))
  );
  ql_counts
  | extend ql_auth_breakdown = ql_auth
  
  '''
# ---
# name: test_discover_kql_default_snapshots
  '''
  // Run each query separately in the Logs editor.
  // === Query 1: Top Query Shapes Query ===
  let ql_reqs = AzureDiagnostics
      | where Category == "DataPlaneRequests" and ResourceProvider =~ "MICROSOFT.DOCUMENTDB"
      | summarize
          ql_total_charge = sum(todouble(coalesce(tostring(column_ifexists("requestCharge_s", "")), tostring(column_ifexists("RequestCharge_s", "")), "0"))),
          ql_is_429 = max(iff(coalesce(tostring(column_ifexists("statusCode_s", "")), tostring(column_ifexists("StatusCode_s", "")), "") == "429", 1, 0)),
          ql_client_ip = take_any(coalesce(tostring(column_ifexists("clientIpAddress_s", "")), tostring(column_ifexists("ClientIpAddress_s", "")), "")),
          ql_aad_principal = take_any(coalesce(tostring(column_ifexists("aadPrincipalId_g", "")), tostring(column_ifexists("AadPrincipalId_g", "")), ""))
        by ql_activity_id = coalesce(tostring(column_ifexists("activityId_g", "")), tostring(column_ifexists("ActivityId_g", "")), "");
  let ql_qrs = AzureDiagnostics
      | where Category == "QueryRuntimeStatistics" and ResourceProvider =~ "MICROSOFT.DOCUMENTDB"
      | extend
          ql_db_name = coalesce(tostring(column_ifexists("databaseName_s", "")), tostring(column_ifexists("databasename_s", "")), tostring(column_ifexists("DatabaseName_s", "")), ""),
          ql_coll_name = coalesce(tostring(column_ifexists("collectionName_s", "")), tostring(column_ifexists("collectionname_s", "")), tostring(column_ifexists("CollectionName_s", "")), ""),
          ql_shape_sig = coalesce(tostring(column_ifexists("shapesignature_s", "")), tostring(column_ifexists("ShapeSignature_s", "")), tostring(column_ifexists("shapeSignature_s", "")), ""),
          ql_raw_text = coalesce(tostring(column_ifexists("querytext_s", "")), tostring(column_ifexists("QueryText_s", "")), tostring(column_ifexists("queryText_s", "")), ""),
          ql_returned_count = todouble(coalesce(tostring(column_ifexists("numberofrowsreturned_s", "")), tostring(column_ifexists("numberOfRowsReturned_s", "")), tostring(column_ifexists("NumberOfRowsReturned_s", "")), "0"))
      | extend ql_shape_key = iff(isnotempty(ql_shape_sig), ql_shape_sig, hash_sha256(ql_raw_text))
      | summarize
          ql_db_name = take_anyif(ql_db_name, isnotempty(ql_db_name)),
          ql_coll_name = take_anyif(ql_coll_name, isnotempty(ql_coll_name)),
          ql_shape_id = take_anyif(ql_shape_key, isnotempty(ql_shape_key)),
          ql_sample_query_text = take_anyif(ql_raw_text, isnotempty(ql_raw_text)),
          ql_returned_rows = sum(ql_returned_count)
        by ql_activity_id = coalesce(tostring(column_ifexists("activityId_g", "")), tostring(column_ifexists("ActivityId_g", "")), "");
  let ql_joined = materialize(
      ql_qrs
      | join kind=inner ql_reqs on ql_activity_id
  );
  let ql_known_db_by_shape_container = ql_joined
  | where isnotempty(ql_db_name) and ql_db_name != "(unknown)"
      and isnotempty(ql_coll_name) and ql_coll_name != "(unknown)"
  | summarize by ql_shape_id, ql_coll_name, ql_known_db = ql_db_name;
  let ql_single_db_shape_containers = ql_known_db_by_shape_container
  | summarize
      ql_db_count = count(),
      ql_resolved_db = take_any(ql_known_db)
    by ql_shape_id, ql_coll_name
  | where ql_db_count == 1;
  let ql_resolved_activities = ql_joined
  | join kind=leftouter ql_single_db_shape_containers on ql_shape_id, ql_coll_name
  | extend
      ql_db_name = iff(
          isnotempty(ql_db_name) and ql_db_name != "(unknown)",
          ql_db_name,
          coalesce(ql_resolved_db, "(unknown)")
      ),
      ql_coll_name = iff(
          isnotempty(ql_coll_name) and ql_coll_name != "(unknown)",
          ql_coll_name,
          "(unknown)"
      );
  let ql_top_shapes = materialize(
      ql_resolved_activities
      | summarize
          ql_execution_count = count(),
          ql_total_ru = sum(ql_total_charge),
          ql_max_ru = max(ql_total_charge),
          ql_total_returned_rows = sum(ql_returned_rows),
          ql_throttled_count = sum(ql_is_429),
          ql_sample_text = take_anyif(ql_sample_query_text, isnotempty(ql_sample_query_text))
        by ql_db_name, ql_coll_name, ql_shape_id
      | top 20 by ql_total_ru desc
  );
  let ql_top_shape_keys = ql_top_shapes
  | project ql_db_name, ql_coll_name, ql_shape_id;
  let ql_top_callers_per_shape = ql_resolved_activities
  | join kind=inner ql_top_shape_keys on ql_db_name, ql_coll_name, ql_shape_id
  | extend
      ql_caller_id = iff(isnotempty(ql_aad_principal), ql_aad_principal, ql_client_ip),
      ql_caller_type = iff(
          isnotempty(ql_aad_principal),
          "aad_principal",
          iff(isnotempty(ql_client_ip), "client_ip", "none")
      )
  | where isnotempty(ql_caller_id) and ql_caller_type != "none"
  | summarize ql_caller_ru = sum(ql_total_charge)
    by ql_db_name, ql_coll_name, ql_shape_id, ql_caller_id, ql_caller_type
  | order by ql_shape_id asc, ql_caller_ru desc
  | summarize
      ql_top_callers = make_list(
          bag_pack(
              "identifier", ql_caller_id,
              "caller_ru", ql_caller_ru,
              "identifier_type", ql_caller_type
          ),
          3
      )
    by ql_db_name, ql_coll_name, ql_shape_id;
  ql_top_shapes
  | join kind=leftouter ql_top_callers_per_shape on ql_db_name, ql_coll_name, ql_shape_id
  | project
      ql_db_name, ql_coll_name, ql_shape_id, ql_sample_text,
      ql_execution_count, ql_total_ru, ql_max_ru, ql_total_returned_rows,
      ql_throttled_count,
      ql_top_callers = coalesce(ql_top_callers, dynamic([]))
  
  // === Query 2: Window & Attributed Totals Query ===
  let ql_reqs = materialize(
      AzureDiagnostics
      | where Category == "DataPlaneRequests" and ResourceProvider =~ "MICROSOFT.DOCUMENTDB"
      | summarize
          ql_total_charge = sum(todouble(coalesce(tostring(column_ifexists("requestCharge_s", "")), tostring(column_ifexists("RequestCharge_s", "")), "0"))),
          ql_earliest_time = min(TimeGenerated)
        by ql_activity_id = coalesce(tostring(column_ifexists("activityId_g", "")), tostring(column_ifexists("ActivityId_g", "")), "")
  );
  let ql_qrs = AzureDiagnostics
      | where Category == "QueryRuntimeStatistics" and ResourceProvider =~ "MICROSOFT.DOCUMENTDB"
      | summarize by ql_activity_id = coalesce(tostring(column_ifexists("activityId_g", "")), tostring(column_ifexists("ActivityId_g", "")), "");
  let ql_window_total = toscalar(ql_reqs | summarize sum(ql_total_charge));
  let ql_min_time = toscalar(ql_reqs | summarize min(ql_earliest_time));
  ql_qrs
  | join kind=inner ql_reqs on ql_activity_id
  | summarize
      ql_attributed_total_ru = sum(ql_total_charge),
      ql_total_executions = count()
  | extend
      ql_window_total_ru = ql_window_total,
      ql_min_time_generated = ql_min_time
  
  '''
